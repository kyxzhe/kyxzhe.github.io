{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "kevin-bot",
  "main": "index.js",
  "compatibility_date": "2026-07-12",
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "kevin-rag-index",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "kevin-bot-history",
      "database_id": "1978f6bb-f382-4eb1-8fbe-04447f7762e5"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "20260710",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
